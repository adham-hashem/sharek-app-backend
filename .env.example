NODE_ENV=production
PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Never expose the service-role key to the mobile app. It is optional and only used by jobs.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Set true only when the API is behind a trusted reverse proxy that sets client IP headers.
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
DEFAULT_CURRENCY=USD
