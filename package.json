{
  "name": "sharek-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "description": "Production API for SHARek meal matching and food donations",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/health.test.ts test/schemas.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.3",
    "@supabase/supabase-js": "^2.58.0",
    "fastify": "^5.4.0",
    "pino": "^9.7.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "~5.9.2",
    "@types/node": "^22.15.0"
    ,"@types/ws": "^8.18.1"
  }
}
